{
  "name": "voice-ai-platform",
  "private": true,
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up",
    "dev:api": "pnpm --filter @voice/api dev",
    "dev:web": "pnpm --filter @voice/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @voice/db generate",
    "db:push": "pnpm --filter @voice/db push",
    "db:migrate": "pnpm --filter @voice/db migrate",
    "db:seed": "pnpm --filter @voice/db seed",
    "db:studio": "pnpm --filter @voice/db studio",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
