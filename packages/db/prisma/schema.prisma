generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  role        String   @default("super_admin")
  name        String?
  companyName String?  @map("company_name")
  phone       String?
  isActive    Boolean  @default(true) @map("is_active")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  parent      User?    @relation("UserHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    User[]   @relation("UserHierarchy")
  agents      Agent[]

  @@index([parentId])
  @@map("users")
}

model Agent {
  id                       String              @id @default(uuid())
  userId                   String?             @map("user_id")
  name                     String
  apiKey                   String?             @unique @map("api_key")
  phoneNumber              String?             @unique @map("phone_number")
  telnyxPhoneId            String?             @map("telnyx_phone_id")
  telnyxAppId              String?             @map("telnyx_app_id")
  status                   String              @default("active")
  voice                    String              @default("Aoede")
  basePrompt               String?             @map("base_prompt") @db.Text
  openingMessage           String?             @map("opening_message") @db.Text
  inboundSystemPrompt      String?             @map("inbound_system_prompt") @db.Text
  inboundOpeningMessage    String?             @map("inbound_opening_message") @db.Text
  summaryEnabled           Boolean             @default(false) @map("summary_enabled")
  summaryPrompt            String?             @map("summary_prompt") @db.Text
  summaryMinDuration       Int                 @default(30) @map("summary_min_duration")
  webhookUrl               String?             @map("webhook_url")
  webhookSecret            String?             @map("webhook_secret")
  webhookRetryCount        Int                 @default(3) @map("webhook_retry_count")
  webhookRetryDelay        Int                 @default(60) @map("webhook_retry_delay")
  appointmentWebhookUrl    String?             @map("appointment_webhook_url")
  appointmentWebhookSecret String?             @map("appointment_webhook_secret")
  modelConfig              Json?               @map("model_config")
  activeHours              Json?               @map("active_hours")
  calendarConfig           Json?               @map("calendar_config")
  calendarInstructions     String?             @map("calendar_instructions") @db.Text
  businessHours            Json?               @map("business_hours")
  whatsappProvider         String?             @map("whatsapp_provider")
  whatsappConfig           String?             @map("whatsapp_config") @db.Text
  whatsappInstructions     String?             @map("whatsapp_instructions") @db.Text
  whatsappContextMessages  Int                 @default(20) @map("whatsapp_context_messages")
  createdAt                DateTime            @default(now()) @map("created_at")
  user                     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  calls                    Call[]
  appointments             Appointment[]
  summaries                CallSummary[]
  scheduledReminders       ScheduledReminder[]
  whatsappMessages         WhatsappMessage[]
  usageMonthly             AgentUsageMonthly[]
  knowledgeDocuments       KnowledgeDocument[]

  @@map("agents")
}

model Contact {
  id                 String              @id @default(uuid())
  phone              String              @unique
  name               String?
  email              String?
  gender             String?
  notes              String?             @db.Text
  metadata           Json?
  totalCalls         Int                 @default(0) @map("total_calls")
  totalDurationSec   Int                 @default(0) @map("total_duration_sec")
  lastCallAt         DateTime?           @map("last_call_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  calls              Call[]
  appointments       Appointment[]
  scheduledReminders ScheduledReminder[]

  @@map("contacts")
}

model Call {
  id                 String              @id @default(uuid())
  agentId            String              @map("agent_id")
  contactId          String?             @map("contact_id")
  callControlId      String?             @map("call_control_id")
  direction          String
  callType           String              @default("regular") @map("call_type")
  status             String              @default("queued")
  context            Json?
  recordingUrl       String?             @map("recording_url")
  recordingStatus    String?             @map("recording_status")
  recordingDuration  Int?                @map("recording_duration")
  recordingSizeBytes Int?                @map("recording_size_bytes")
  telnyxRecordingId  String?             @unique @map("telnyx_recording_id")
  retryCount         Int                 @default(0) @map("retry_count")
  durationSec        Int?                @map("duration_sec")
  startedAt          DateTime?           @map("started_at")
  endedAt            DateTime?           @map("ended_at")
  audioInputTokens   Int?                @map("audio_input_tokens")
  audioOutputTokens  Int?                @map("audio_output_tokens")
  textInputTokens    Int?                @map("text_input_tokens")
  textOutputTokens   Int?                @map("text_output_tokens")
  telnyxBilledSec    Int?                @map("telnyx_billed_sec")
  deepgramSec        Int?                @map("deepgram_sec")
  createdAt          DateTime            @default(now()) @map("created_at")
  agent              Agent               @relation(fields: [agentId], references: [id])
  contact            Contact?            @relation(fields: [contactId], references: [id])
  utterances         Utterance[]
  appointments       Appointment[]
  summary            CallSummary?
  scheduledReminders ScheduledReminder[]

  @@index([agentId, createdAt])
  @@index([callControlId])
  @@map("calls")
}

model Utterance {
  id      String @id @default(uuid())
  callId  String @map("call_id")
  speaker String
  startMs Int    @map("start_ms")
  endMs   Int    @map("end_ms")
  text    String @db.Text
  call    Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, startMs])
  @@map("utterances")
}

model Appointment {
  id                 String              @id @default(uuid())
  agentId            String              @map("agent_id")
  contactId          String?             @map("contact_id")
  callId             String?             @map("call_id")
  googleEventId      String?             @map("google_event_id")
  title              String
  description        String?             @db.Text
  phone              String
  startTime          DateTime            @map("start_time")
  endTime            DateTime            @map("end_time")
  duration           Int
  status             String              @default("scheduled")
  webhookStatus      String              @default("NONE") @map("webhook_status")
  webhookAttempts    Int                 @default(0) @map("webhook_attempts")
  webhookLastError   String?             @map("webhook_last_error") @db.Text
  webhookSentAt      DateTime?           @map("webhook_sent_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  agent              Agent               @relation(fields: [agentId], references: [id])
  contact            Contact?            @relation(fields: [contactId], references: [id])
  call               Call?               @relation(fields: [callId], references: [id])
  scheduledReminders ScheduledReminder[]

  @@index([agentId, startTime])
  @@index([contactId])
  @@map("appointments")
}

model ScheduledReminder {
  id              String      @id @default(uuid())
  appointmentId   String      @map("appointment_id")
  agentId         String      @map("agent_id")
  contactId       String?     @map("contact_id")
  callId          String?     @map("call_id")
  ruleIndex       Int         @map("rule_index")
  scheduledFor    DateTime    @map("scheduled_for")
  status          String      @default("PENDING")
  contentType     String      @map("content_type")
  resolvedContent String?     @map("resolved_content") @db.Text
  attempts        Int         @default(0)
  lastAttemptAt   DateTime?   @map("last_attempt_at")
  lastError       String?     @map("last_error") @db.Text
  bullmqJobId     String?     @map("bullmq_job_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  agent           Agent       @relation(fields: [agentId], references: [id])
  contact         Contact?    @relation(fields: [contactId], references: [id])
  call            Call?       @relation(fields: [callId], references: [id])

  @@unique([appointmentId, ruleIndex])
  @@index([agentId, status])
  @@index([scheduledFor, status])
  @@map("scheduled_reminders")
}

model WhatsappMessage {
  id                String   @id @default(uuid())
  agentId           String   @map("agent_id")
  contactPhone      String   @map("contact_phone")
  direction         String
  status            String   @default("pending")
  content           String   @db.Text
  providerMessageId String?  @map("provider_message_id")
  callId            String?  @map("call_id")
  errorCode         String?  @map("error_code")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, contactPhone, createdAt])
  @@index([callId])
  @@index([providerMessageId])
  @@map("whatsapp_messages")
}

model CallSummary {
  id               String    @id @default(uuid())
  callId           String    @unique @map("call_id")
  agentId          String    @map("agent_id")
  summaryText      String    @map("summary_text") @db.Text
  utteranceCount   Int       @map("utterance_count")
  callDurationSec  Int       @map("call_duration_sec")
  tokenCount       Int?      @map("token_count")
  webhookStatus    String    @default("NONE") @map("webhook_status")
  webhookAttempts  Int       @default(0) @map("webhook_attempts")
  webhookLastError String?   @map("webhook_last_error") @db.Text
  webhookSentAt    DateTime? @map("webhook_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  call             Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  agent            Agent     @relation(fields: [agentId], references: [id])

  @@index([agentId, webhookStatus])
  @@map("call_summaries")
}

model PricingConfig {
  id                     String @id @default("singleton")
  geminiAudioInputPer1M  Float  @default(3.00) @map("gemini_audio_input_per_1m")
  geminiAudioOutputPer1M Float  @default(12.00) @map("gemini_audio_output_per_1m")
  geminiTextInputPer1M   Float  @default(0.50) @map("gemini_text_input_per_1m")
  geminiTextOutputPer1M  Float  @default(2.00) @map("gemini_text_output_per_1m")
  geminiSummaryPer1M     Float  @default(0.25) @map("gemini_summary_per_1m")
  embeddingPer1M         Float  @default(0.15) @map("embedding_per_1m")
  telnyxCallPerMin       Float  @default(0.007) @map("telnyx_call_per_min")
  telnyxRecordingPerMin  Float  @default(0.002) @map("telnyx_recording_per_min")
  deepgramPerSec         Float  @default(0.000128) @map("deepgram_per_sec")
  usdToIls               Float  @default(3.65) @map("usd_to_ils")

  @@map("pricing_config")
}

model AgentUsageMonthly {
  id                     String @id @default(uuid())
  agentId                String @map("agent_id")
  yearMonth              String @map("year_month")
  callCount              Int    @default(0) @map("call_count")
  totalDurationSec       Int    @default(0) @map("total_duration_sec")
  totalBilledSec         Int    @default(0) @map("total_billed_sec")
  totalAudioInputTokens  Int    @default(0) @map("total_audio_input_tokens")
  totalAudioOutputTokens Int    @default(0) @map("total_audio_output_tokens")
  totalTextInputTokens   Int    @default(0) @map("total_text_input_tokens")
  totalTextOutputTokens  Int    @default(0) @map("total_text_output_tokens")
  totalSummaryTokens     Int    @default(0) @map("total_summary_tokens")
  totalEmbeddingTokens   Int    @default(0) @map("total_embedding_tokens")
  totalDeepgramSec       Int    @default(0) @map("total_deepgram_sec")
  totalRecordingSec      Int    @default(0) @map("total_recording_sec")
  whatsappMsgCount       Int    @default(0) @map("whatsapp_msg_count")
  agent                  Agent  @relation(fields: [agentId], references: [id])

  @@unique([agentId, yearMonth])
  @@map("agent_usage_monthly")
}

model KnowledgeDocument {
  id            String           @id @default(uuid())
  agentId       String           @map("agent_id")
  name          String
  docType       String           @map("doc_type")
  status        String           @default("processing")
  errorMsg      String?          @map("error_msg") @db.Text
  chunkCount    Int              @default(0) @map("chunk_count")
  fileSizeBytes Int              @default(0) @map("file_size_bytes")
  createdAt     DateTime         @default(now()) @map("created_at")
  agent         Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([agentId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String            @map("document_id")
  agentId    String            @map("agent_id")
  chunkType  String            @default("child") @map("chunk_type")
  parentId   String?           @map("parent_id")
  content    String            @db.Text
  embedding  Unsupported("vector(1536)")?
  importance Float             @default(0.5)
  metadata   Json?
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([agentId, chunkType])
  @@index([parentId])
  @@map("knowledge_chunks")
}
